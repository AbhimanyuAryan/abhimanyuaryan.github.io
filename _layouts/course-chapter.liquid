---
layout: default
---
{% assign course_entry = site.course_catalog | where: 'course_slug', page.course_slug | first %}
{% assign ch_id = page.chapter_id | default: page.slug %}

<div class="post">
  <p>
    {% if course_entry %}
      <a href="{{ course_entry.url | relative_url }}#{{ ch_id }}"> <i class="fa-solid fa-arrow-left fa-sm"></i> {{ course_entry.title }} </a>
    {% else %}
      <a href="{{ '/courses/' | relative_url }}"><i class="fa-solid fa-arrow-left fa-sm"></i> All Courses</a>
    {% endif %}
  </p>

  <header class="post-header">
    {% if page.part_label %}
      <p class="post-meta" style="letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.75rem;">
        {{ page.part_label }}
      </p>
    {% endif %}
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  {% if page.youtube_id and page.youtube_id != '' %}
    <div
      class="video-container"
      style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; max-width: 100%; margin-bottom: 2rem;"
    >
      <iframe
        src="https://www.youtube.com/embed/{{ page.youtube_id }}"
        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        title="{{ page.title }}"
      ></iframe>
    </div>
  {% endif %}

  <article class="post-content">{{ content }}</article>

  {% if course_entry %}
    <hr>
    <p style="margin-top: 1rem;">
      <a href="{{ course_entry.url | relative_url }}#{{ ch_id }}">
        Open this chapter inside the full course <i class="fa-solid fa-arrow-right fa-sm"></i>
      </a>
    </p>
  {% endif %}
</div>

---
layout: default
---
<div class="post">

  <p style="margin-bottom: 1.5rem;">
    <a href="{{ '/courses/' | relative_url }}">
      <i class="fa-solid fa-arrow-left fa-sm"></i> All Courses
    </a>
  </p>

  <div class="row align-items-center mb-4">
    <div class="col-md-5 mb-3 mb-md-0">
      <div style="position: relative; padding-bottom: 56.25%; background: #000; border-radius: 8px; overflow: hidden;">
        <img
          src="https://img.youtube.com/vi/{{ page.thumbnail_youtube_id }}/hqdefault.jpg"
          alt="{{ page.title }}"
          style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;"
        >
        {% if page.playlist_url %}
          <a href="{{ page.playlist_url }}" target="_blank" rel="noopener noreferrer"
             style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
                    background: rgba(0,0,0,0.35); text-decoration: none;">
            <div style="background: rgba(0,0,0,0.75); border-radius: 50%; width: 56px; height: 56px;
                        display: flex; align-items: center; justify-content: center;">
              <i class="fa-brands fa-youtube" style="color: #ff0000; font-size: 1.8rem;"></i>
            </div>
          </a>
        {% endif %}
      </div>
    </div>

    <div class="col-md-7">
      <header>
        <h1 class="post-title" style="margin-bottom: 0.5rem;">{{ page.title }}</h1>
        <p style="font-size: 1.05rem; margin-bottom: 1rem;">{{ page.description }}</p>

        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem;">
          {% if page.level %}
            <span class="badge" style="background: var(--global-theme-color); color: white; padding: 4px 10px; border-radius: 20px; font-size: 0.8rem;">
              {{ page.level }}
            </span>
          {% endif %}
          {% if page.language %}
            <span class="badge" style="background: var(--global-divider-color); color: var(--global-text-color); padding: 4px 10px; border-radius: 20px; font-size: 0.8rem;">
              <i class="fa-solid fa-language fa-sm"></i> {{ page.language }}
            </span>
          {% endif %}
          {% assign lesson_count = site.courses | where: "course_slug", page.course_slug | size %}
          <span class="badge" style="background: var(--global-divider-color); color: var(--global-text-color); padding: 4px 10px; border-radius: 20px; font-size: 0.8rem;">
            <i class="fa-solid fa-film fa-sm"></i> {{ lesson_count }} lesson{% if lesson_count != 1 %}s{% endif %}
          </span>
        </div>

        {% if page.tags %}
          <p style="margin: 0;">
            {% for tag in page.tags %}
              <i class="fa-solid fa-hashtag fa-sm"></i> <span style="font-size: 0.85rem;">{{ tag }}</span>
              {% unless forloop.last %}&nbsp;{% endunless %}
            {% endfor %}
          </p>
        {% endif %}
      </header>
    </div>
  </div>

  {% if content and content != "" %}
    <div class="post-content" style="margin-bottom: 2rem;">
      {{ content }}
    </div>
    <hr>
  {% endif %}

  <h2 style="margin-bottom: 1.5rem;">Lessons</h2>

  {% assign lessons = site.courses | where: "course_slug", page.course_slug | sort: "order" %}
  <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
    {% for lesson in lessons %}
      <div class="col">
        <a href="{{ lesson.url | relative_url }}" style="text-decoration: none; color: inherit;">
          <div class="card h-100 hoverable" style="border-radius: 8px; overflow: hidden;">
            <div style="position: relative; padding-bottom: 56.25%; background: #000;">
              <img
                src="https://img.youtube.com/vi/{{ lesson.youtube_id }}/hqdefault.jpg"
                alt="{{ lesson.title }}"
                style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;"
                loading="lazy"
              >
              <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
                          background: rgba(0,0,0,0.65); border-radius: 50%;
                          width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;">
                <i class="fa-solid fa-play" style="color: white; font-size: 1rem; margin-left: 3px;"></i>
              </div>
              <span style="position: absolute; top: 8px; left: 8px;
                           background: rgba(0,0,0,0.7); color: white;
                           font-size: 0.75rem; padding: 2px 7px; border-radius: 4px;">
                #{{ lesson.order }}
              </span>
            </div>
            <div class="card-body" style="padding: 0.75rem;">
              <h6 class="card-title" style="margin-bottom: 0.25rem; font-size: 0.9rem; line-height: 1.3;">
                {{ lesson.title }}
              </h6>
              {% if lesson.description %}
                <p class="card-text" style="font-size: 0.8rem; color: var(--global-text-color-light);
                                             margin: 0; display: -webkit-box; -webkit-line-clamp: 2;
                                             -webkit-box-orient: vertical; overflow: hidden;">
                  {{ lesson.description }}
                </p>
              {% endif %}
            </div>
          </div>
        </a>
      </div>
    {% endfor %}
  </div>

</div>

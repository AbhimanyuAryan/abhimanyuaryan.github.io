---
layout: default
---
<div class="post">
  <p>
    <a href="{{ '/courses/' | relative_url }}"> <i class="fa-solid fa-arrow-left fa-sm"></i> {{ page.course }} </a>
  </p>

  <header class="post-header">
    <p class="post-meta">
      <i class="fa-solid fa-film fa-sm"></i> Lesson {{ page.order }}
      &nbsp; &middot; &nbsp;
      {{ page.course }}
    </p>
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  {% if page.youtube_id %}
    <div
      class="video-container"
      style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; max-width: 100%; margin-bottom: 2rem;"
    >
      <iframe
        src="https://www.youtube.com/embed/{{ page.youtube_id }}"
        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        title="{{ page.title }}"
      ></iframe>
    </div>
  {% endif %}

  <article class="post-content">
    <div id="markdown-content">
      {{ content }}
    </div>
  </article>

  {% if page.notebook %}
    <hr>
    <h2>Notebook</h2>
    {% jupyter_notebook page.notebook %}
  {% endif %}

  <hr>

  {% assign course_lessons = site.courses | where: 'course_slug', page.course_slug | sort: 'order' %}
  {% assign total = course_lessons | size %}
  {% assign current_index = 0 %}
  {% for lesson in course_lessons %}
    {% if lesson.url == page.url %}
      {% assign current_index = forloop.index0 %}
    {% endif %}
  {% endfor %}

  {% assign prev_index = current_index | minus: 1 %}
  {% assign next_index = current_index | plus: 1 %}

  <div class="lesson-navigation" style="display: flex; justify-content: space-between; margin-top: 1.5rem;">
    <div>
      {% if current_index > 0 %}
        {% assign prev_lesson = course_lessons[prev_index] %}
        <a href="{{ prev_lesson.url | relative_url }}"> <i class="fa-solid fa-arrow-left fa-sm"></i> {{ prev_lesson.title }} </a>
      {% endif %}
    </div>
    <div>
      {% if next_index < total %}
        {% assign next_lesson = course_lessons[next_index] %}
        <a href="{{ next_lesson.url | relative_url }}">
          {{ next_lesson.title }}
          <i class="fa-solid fa-arrow-right fa-sm"></i>
        </a>
      {% endif %}
    </div>
  </div>

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
